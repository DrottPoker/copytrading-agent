{
  "enabled": true,
  "schedule": {
    "run_on_worker_start": true,
    "interval_seconds": 600
  },
  "window": {
    "days": 60,
    "min_fills": 20,
    "target_fills": 100,
    "min_trades": 5,
    "sample_cap_max_score": 45
  },
  "component_weights": {
    "profitability": 0.3,
    "consistency": 0.2,
    "risk": 0.2,
    "copyability": 0.2,
    "recency": 0.1
  },
  "profitability": {
    "weights": {
      "net_roi": 0.50,
      "average_trade_roi": 0.20,
      "median_trade_roi": 0.30
    },
    "roi_score": {
      "full_score_at": 0.04
    },
    "average_trade_roi": {
      "cap_min": -0.05,
      "cap_max": 0.1
    }
  },
  "consistency": {
    "weights": {
      "profit_distribution": 0.25,
      "largest_win_dependency": 0.2,
      "trade_roi_stability": 0.2,
      "downside_stability": 0.15,
      "active_day_regularity": 0.1,
      "max_inactive_gap": 0.1
    },
    "profit_distribution": {
      "full_score_ratio": 0.75
    },
    "largest_win_dependency": {
      "full_score_at_or_below": 0.15,
      "zero_score_at_or_above": 0.6
    },
    "trade_roi_stability": {
      "full_score_stddev_at_or_below": 0.01,
      "zero_score_stddev_at_or_above": 0.1
    },
    "downside_stability": {
      "full_score_stddev_at_or_below": 0.005,
      "zero_score_stddev_at_or_above": 0.05
    },
    "active_day_regularity": {
      "full_score_active_day_ratio": 0.5
    },
    "max_inactive_gap": {
      "full_score_days": 2,
      "zero_score_days": 21
    }
  },
  "risk": {
    "loss_ratio": {
      "penalty_per_ratio": 40,
      "penalty_max": 40
    },
    "realized_drawdown": {
      "penalty_per_ratio": 35,
      "penalty_max": 35
    },
    "losing_trade_rate": {
      "penalty_per_ratio": 15
    },
    "current_drawdown": {
      "enabled": true,
      "concurrency": 8,
      "missing_penalty": 10,
      "penalty_start_ratio": 0.05,
      "full_penalty_ratio": 0.75,
      "penalty_max": 100,
      "score_cap_start_ratio": 0.25,
      "score_cap_zero_ratio": 1
    },
    "open_position_stress": {
      "notional_full_ratio": 10,
      "penalty_max": 20
    },
    "forced_exit": {
      "event_gap_seconds": 300,
      "notional_full_ratio": 0.25,
      "penalty_max": 15
    }
  },
  "copyability": {
    "weights": {
      "copyable_trade_ratio": 0.35,
      "median_trade_notional": 0.22,
      "p25_trade_notional": 0.18,
      "execution_simplicity": 0.10,
      "forced_exit_frequency": 0.15
    },
    "copyable_trade_ratio": {
      "min_trade_notional_usd": 5
    },
    "trade_notional": {
      "min_full_score_usd": 50,
      "max_full_score_usd": 250000,
      "too_large_min_score_usd": 1000000,
      "too_small_max_score": 70,
      "too_large_min_score": 40
    },
    "execution_simplicity": {
      "full_score_fills_per_trade_at_or_below": 4,
      "zero_score_fills_per_trade_at_or_above": 20
    },
    "forced_exit_frequency": {
      "zero_score_ratio": 0.2
    }
  },
  "recency": {
    "stale_days": 7
  },
  "penalties": {
    "no_closed_trades": 100,
    "low_sample_max": 20,
    "negative_pnl_max": 10,
    "stale_recency": 10,
    "open_only": 10,
    "confidence": {
      "target_trades": 30,
      "max": 8
    }
  },
  "window_scores": {
    "activity_trade_cap": 10,
    "weight_profitability": 0.8,
    "weight_activity": 0.2
  }
}
