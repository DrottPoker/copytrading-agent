{
  "enabled": true,
  "schedule": {
    "run_on_worker_start": true,
    "interval_seconds": 600
  },
  "window": {
    "days": 60,
    "min_fills": 20,
    "target_fills": 100,
    "min_trades": 20,
    "sample_cap_max_score": 45
  },
  "equity": {
    "enabled": true,
    "refresh_hours": 6,
    "max_wallets_per_run": 60,
    "concurrency": 4,
    "min_points": 8,
    "min_coverage_days": 7,
    "min_account_value_usd": 10
  },
  "component_weights": {
    "profitability": 0.25,
    "consistency": 0.2,
    "risk": 0.25,
    "copyability": 0.15,
    "recency": 0.15
  },
  "profitability": {
    "weights": {
      "equity_return": 0.5,
      "average_trade_roi": 0.2,
      "median_trade_roi": 0.3
    },
    "equity_return": {
      "full_score_at": 0.1
    },
    "roi_score": {
      "full_score_at": 0.04
    },
    "average_trade_roi": {
      "cap_min": -0.05,
      "cap_max": 0.1
    }
  },
  "consistency": {
    "weights": {
      "profit_distribution": 0.25,
      "largest_win_dependency": 0.2,
      "trade_roi_stability": 0.2,
      "downside_stability": 0.15,
      "active_day_regularity": 0.1,
      "max_inactive_gap": 0.1
    },
    "profit_distribution": {
      "full_score_ratio": 0.75
    },
    "largest_win_dependency": {
      "full_score_at_or_below": 0.15,
      "zero_score_at_or_above": 0.6
    },
    "trade_roi_stability": {
      "full_score_stddev_at_or_below": 0.01,
      "zero_score_stddev_at_or_above": 0.1
    },
    "downside_stability": {
      "full_score_stddev_at_or_below": 0.005,
      "zero_score_stddev_at_or_above": 0.05
    },
    "active_day_regularity": {
      "full_score_active_day_ratio": 0.5
    },
    "max_inactive_gap": {
      "full_score_days": 2,
      "zero_score_days": 21
    }
  },
  "risk": {
    "loss_ratio": {
      "penalty_per_ratio": 40,
      "penalty_max": 40
    },
    "equity_drawdown": {
      "penalty_start_ratio": 0.05,
      "full_penalty_ratio": 0.4,
      "penalty_max": 35
    },
    "realized_drawdown": {
      "penalty_per_ratio": 35,
      "penalty_max": 35
    },
    "underwater_adds": {
      "full_penalty_ratio": 0.4,
      "penalty_max": 20
    },
    "losing_trade_rate": {
      "penalty_per_ratio": 15
    },
    "current_drawdown": {
      "enabled": true,
      "concurrency": 8,
      "missing_penalty": 10,
      "run_timeout_seconds": 300,
      "penalty_start_ratio": 0.05,
      "full_penalty_ratio": 0.75,
      "penalty_max": 100,
      "score_cap_start_ratio": 0.25,
      "score_cap_zero_ratio": 1
    },
    "open_position_stress": {
      "notional_full_ratio": 10,
      "penalty_max": 20
    },
    "forced_exit": {
      "event_gap_seconds": 300,
      "notional_full_ratio": 0.25,
      "penalty_max": 15
    }
  },
  "copyability": {
    "weights": {
      "copy_size_ratio": 0.4,
      "median_copy_notional": 0.2,
      "p25_copy_notional": 0.15,
      "execution_simplicity": 0.1,
      "forced_exit_fill_ratio": 0.15
    },
    "reference_equity_usd": 1000,
    "copy_notional": {
      "median_full_score_multiple": 5,
      "p25_full_score_multiple": 2
    },
    "small_copy_cap": {
      "min_ratio": 0.5,
      "max_score": 45
    },
    "execution_simplicity": {
      "full_score_fills_per_trade_at_or_below": 4,
      "zero_score_fills_per_trade_at_or_above": 50
    },
    "forced_exit_fill_ratio": {
      "zero_score_ratio": 0.1
    }
  },
  "recency": {
    "stale_days": 14
  },
  "penalties": {
    "no_closed_trades": 100,
    "low_sample_max": 20,
    "negative_pnl_max": 10,
    "stale_recency": 10,
    "open_only": 10
  },
  "shrinkage": {
    "full_credibility_trades": 40,
    "neutral_score": 50
  },
  "window_scores": {
    "activity_trade_cap": 10,
    "weight_profitability": 0.8,
    "weight_activity": 0.2
  }
}
