{
  "app_name": "Hyperliquid Copy Agent",
  "app_version": "0.1.0",
  "app_env": "development",
  "log_level": "info",
  "worker_run_in_api_process": false,
  "worker_role": "all",
  "worker_heartbeat_interval_seconds": 60,
  "worker_heartbeat_stale_seconds": 180,
  "worker_capability_lease_ttl_seconds": 90,
  "worker_loop_restart_delay_seconds": 5,
  "worker_shutdown_drain_seconds": 30,
  "realtime_execution_queue_size": 1000,
  "realtime_execution_claim_timeout_seconds": 300,
  "realtime_execution_retry_base_seconds": 5,
  "ops_disk_path": "/",
  "backup_status_enabled": true,
  "backup_status_directory": "/app/backups/postgres",
  "backup_status_stale_seconds": 129600,
  "hyperliquid_network": "mainnet",
  "hyperliquid_info_request_retries": 4,
  "hyperliquid_info_retry_base_delay_seconds": 1.5,
  "hyperliquid_info_retry_max_delay_seconds": 20,
  "hyperliquid_info_min_request_interval_seconds": 0.5,
  "paper_trading_enabled": true,
  "wallet_pool_page_limit": 300,
  "active_copy_wallets": 10,
  "max_realtime_wallets": 10,
  "realtime_subscription_refresh_seconds": 15,
  "realtime_reconnect_seconds": 5,
  "dashboard_auth_enabled": true,
  "cors_origins": [
    "http://localhost:3000",
    "http://127.0.0.1:3000"
  ]
}
