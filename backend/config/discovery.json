{
  "enabled": true,
  "sources": {
    "default": [
      "hyperliquid_leaderboard_day",
      "hyperliquid_leaderboard_week",
      "hyperliquid_leaderboard_month",
      "hyperliquid_vault_leaders_week",
      "hyperliquid_vault_leaders",
      "hyperdash_tagged",
      "hyperdash_cohorts",
      "hyperdash_copytrading"
    ],
    "hyperliquid": {
      "sort_metric": "pnl",
      "url": null,
      "vaults_url": null
    },
    "hyperdash": {
      "urls": {
        "copytrading": "https://hyperdash.com/explore/copytraders",
        "cohorts": "https://hyperdash.com/explore/cohorts/profitable",
        "tagged": "https://hyperdash.com/explore/tagged"
      }
    }
  },
  "import": {
    "limit": 100,
    "interval_seconds": 21600,
    "run_on_worker_start": true,
    "subaccounts": {
      "enabled": true,
      "max_per_wallet": 10
    }
  },
  "prefilter": {
    "enabled": true,
    "run_after_import": true,
    "reject_missing_source_pnl": false,
    "require_positive_source_pnl": true,
    "min_source_pnl_usd": 0,
    "min_source_roi": 0,
    "min_account_value_usd": 1000,
    "max_account_value_usd": 100000000,
    "min_copy_score": null,
    "max_source_rank": null,
    "accept_if_metrics_missing": true
  },
  "candidate_backfill": {
    "days": 60,
    "max_pages": 5,
    "target_fills": 10000,
    "batch_size": 10
  },
  "quality": {
    "min_fills": 20,
    "min_closed_trades": 5,
    "require_positive_net_pnl": true,
    "min_profit_factor": 1.2,
    "min_win_rate": null,
    "max_drawdown_pct": 0.40,
    "min_average_trade_notional_usd": 50,
    "max_average_trade_notional_usd": 250000
  },
  "promotion": {
    "batch_size": 25,
    "require_backfill": true
  }
}
