# Tweakable non-secret config lives in the backend and frontend config folders:
# - backend/config/app.json
# - backend/config/backup.env
# - backend/config/database.json
# - backend/config/discovery.json
# - backend/config/live_trading.json
# - backend/config/paper_trading.json
# - backend/config/pool_fill_import.json
# - backend/config/prune.json
# - backend/config/scoring.json
# - backend/config/trading.json
# - frontend/config/app.json

POSTGRES_DB=copyagent
POSTGRES_USER=copyagent
# Use a URL-safe password. For VPS, generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-strong-hex-password

# Docker Compose builds DATABASE_URL from POSTGRES_* and the local postgres service.
# Leave these empty unless you run the backend outside Compose or use an external DB.
DATABASE_URL=
DATABASE_URL_DIRECT=

REDIS_URL=redis://redis:6379/0

HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_WALLET_ADDRESS=
LIVE_TRADING_ENABLED=false

DASHBOARD_AUTH_USERNAME=admin
DASHBOARD_AUTH_PASSWORD=replace-with-your-private-password

# Use :80 for temporary IP-only HTTP, or a DNS name for automatic HTTPS.
DASHBOARD_DOMAIN=:80
