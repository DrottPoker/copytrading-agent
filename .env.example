# Tweakable non-secret config lives in:
# - backend/config/app.json
# - backend/config/discovery.json
# - backend/config/live_trading.json
# - backend/config/paper_trading.json
# - backend/config/pool_fill_import.json
# - backend/config/prune.json
# - backend/config/scoring.json
# - frontend/config/app.json

POSTGRES_DB=copyagent
POSTGRES_USER=copyagent
# Use a URL-safe password. For VPS, generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-strong-hex-password

# Docker Compose builds DATABASE_URL from POSTGRES_* and the local postgres service.
# Leave these empty unless you run the backend outside Compose or use an external DB.
DATABASE_URL=
DATABASE_URL_DIRECT=

REDIS_URL=redis://redis:6379/0

WORKER_HEARTBEAT_INTERVAL_SECONDS=60
WORKER_HEARTBEAT_STALE_SECONDS=180
# Capability leases prevent duplicate trading or maintenance runtimes. Both the
# lease TTL and stale threshold must be greater than the heartbeat interval.
WORKER_CAPABILITY_LEASE_TTL_SECONDS=90
WORKER_LOOP_RESTART_DELAY_SECONDS=5
WORKER_SHUTDOWN_DRAIN_SECONDS=30
REALTIME_EXECUTION_QUEUE_SIZE=1000
REALTIME_EXECUTION_CLAIM_TIMEOUT_SECONDS=300
REALTIME_EXECUTION_RETRY_BASE_SECONDS=5
OPS_DISK_PATH=/
BACKUP_STATUS_ENABLED=true
BACKUP_STATUS_DIRECTORY=/app/backups/postgres
BACKUP_STATUS_STALE_SECONDS=129600
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7

# Docker Compose sets WORKER_ROLE per worker service.
# Use WORKER_ROLE=all, trading, or maintenance only when running a worker manually.

HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_WALLET_ADDRESS=

# Live trading is disabled by repository defaults. Only add these overrides during
# an intentional activation. Mainnet entry arming expires after at most 24 hours.
# Reduce-only exits remain available after entry arming expires.
# HYPERLIQUID_NETWORK=mainnet
# LIVE_TRADING_ENABLED=true
# LIVE_TRADING_ACKNOWLEDGED=true
# LIVE_TRADING_MAINNET_ACKNOWLEDGED=true
# LIVE_TRADING_COPY_ENABLED=true
# LIVE_TRADING_ALLOWED_COINS=BTC,ETH
# LIVE_TRADING_MAINNET_ARMING_TOKEN=ARM_MAINNET_LIVE_TRADING
# LIVE_TRADING_MAINNET_ARMED_AT=YYYY-MM-DDTHH:MM:SSZ
# LIVE_TRADING_MAINNET_ARMED_UNTIL=YYYY-MM-DDTHH:MM:SSZ
# The database live-entry control starts paused after the Phase 6 migration.
# Review reconciliation and risk limits, then resume entries explicitly in Accounts.

DASHBOARD_AUTH_USERNAME=admin
# Production requires at least 16 characters. Generate and store a unique secret.
DASHBOARD_AUTH_PASSWORD=replace-with-a-strong-password
DASHBOARD_AUTH_ENABLED=true
SERVER_API_BASE_URL=http://backend:8000
# Browser mutations must be same-origin or match the backend CORS allowlist.
# CORS_ORIGINS=https://dashboard.example.com

# Use a DNS name that resolves to the VPS so Caddy can provision TLS.
DASHBOARD_DOMAIN=dashboard.example.com
